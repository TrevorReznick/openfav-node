    {
      "name": "AI Generated Pages",
      "item": [
        {
          "name": "Save AI Generated Page",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-123\",\n  \"pageData\": {\n    \"pageId\": \"ai-generated/page-1\",\n    \"page\": {\n      \"id\": \"ai-generated/page-1\",\n      \"title\": \"AI Generated Page\",\n      \"content\": \"This page was generated by AI\",\n      \"createdAt\": \"2024-02-04T10:31:00Z\",\n      \"updatedAt\": \"2024-02-04T10:31:00Z\",\n      \"userId\": \"user-123\"\n    },\n    \"prompt\": \"Generate a test page for Openfav\",\n    \"metadata\": {\n      \"model\": \"gpt-4\",\n      \"attempt\": 1,\n      \"tokens\": { \"prompt\": 10, \"completion\": 50, \"total\": 60 },\n      \"cached\": false,\n      \"generated_at\": \"2024-02-04T10:31:00Z\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{node_server}}/api/ai-pages/save",
              "host": ["{{node_server}}"],
              "path": ["api", "ai-pages", "save"]
            },
            "description": "Save an AI generated page to Redis with key format: ai_generated_pages:{userId}:{pageId}"
          }
        },
        {
          "name": "Get AI Generated Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node_server}}/api/ai-pages/get?userId=user-123&pageId=ai-generated/page-1",
              "host": ["{{node_server}}"],
              "path": ["api", "ai-pages", "get"],
              "query": [
                {
                  "key": "userId",
                  "value": "user-123",
                  "description": "User ID"
                },
                {
                  "key": "pageId",
                  "value": "ai-generated/page-1",
                  "description": "Page ID to retrieve"
                }
              ]
            },
            "description": "Retrieve an AI generated page from Redis"
          }
        },
        {
          "name": "Delete AI Generated Page",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{node_server}}/api/ai-pages/delete?userId=user-123&pageId=ai-generated/page-1",
              "host": ["{{node_server}}"],
              "path": ["api", "ai-pages", "delete"],
              "query": [
                {
                  "key": "userId",
                  "value": "user-123",
                  "description": "User ID"
                },
                {
                  "key": "pageId",
                  "value": "ai-generated/page-1",
                  "description": "Page ID to delete"
                }
              ]
            },
            "description": "Delete an AI generated page from Redis"
          }
        },
        {
          "name": "Get User AI Generated Pages",
