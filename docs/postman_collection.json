{
  "info": {
    "name": "OpenFav Node API",
    "description": "Collection for OpenFav Node.js application endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Main Routes",
      "item": [
        {
          "name": "Home",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node_server}}/",
              "host": ["{{node_server}}"],
              "path": [""]
            },
            "description": "Welcome message endpoint"
          }
        },
        {
          "name": "Test API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node_server}}/api/test-api",
              "host": ["{{node_server}}"],
              "path": ["api", "test-api"]
            },
            "description": "Test API endpoint"
          }
        },
        {
          "name": "Test Mail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node_server}}/api/test-mail",
              "host": ["{{node_server}}"],
              "path": ["api", "test-mail"]
            },
            "description": "Test mail functionality"
          }
        },
        {
          "name": "Send Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"test@example.com\",\n  \"subject\": \"Test Email\",\n  \"text\": \"This is a test email\",\n  \"html\": \"<p>This is a <b>test email</b></p>\"\n}"
            },
            "url": {
              "raw": "{{node_server}}/api/send-email",
              "host": ["{{node_server}}"],
              "path": ["api", "send-email"]
            },
            "description": "Send email endpoint"
          }
        }
      ]
    },
    {
      "name": "Storage Routes",
      "item": [
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{node_server}}/api/upload",
              "host": ["{{node_server}}"],
              "path": ["api", "upload"]
            },
            "description": "Upload image endpoint"
          }
        }
      ]
    },
    {
      "name": "Redis/Session Routes",
      "item": [
        {
          "name": "Set Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user123\",\n  \"sessionData\": {\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"preferences\": {\n      \"theme\": \"dark\",\n      \"language\": \"en\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{node_server}}/api/set-session",
              "host": ["{{node_server}}"],
              "path": ["api", "set-session"]
            },
            "description": "Save user session in Redis"
          }
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node_server}}/api/session/user123",
              "host": ["{{node_server}}"],
              "path": ["api", "session", "user123"]
            },
            "description": "Get user session from Redis"
          }
        },
        {
          "name": "Test Redis",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node_server}}/api/test-redis",
              "host": ["{{node_server}}"],
              "path": ["api", "test-redis"]
            },
            "description": "Test Redis connection"
          }
        }
      ]
    },
    {
      "name": "Controller Routes",
      "item": [
        {
          "name": "Test Controller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Test controller request\",\n  \"data\": {\n    \"param1\": \"value1\",\n    \"param2\": \"value2\"\n  }\n}"
            },
            "url": {
              "raw": "{{node_server}}/api/test-controller",
              "host": ["{{node_server}}"],
              "path": ["api", "test-controller"]
            },
            "description": "Test custom controller"
          }
        }
      ]
    },
    {
      "name": "SSE Routes",
      "item": [
        {
          "name": "SSE Stream",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "Cache-Control",
                "value": "no-cache"
              }
            ],
            "url": {
              "raw": "{{node_server}}/stream/sse",
              "host": ["{{node_server}}"],
              "path": ["stream", "sse"]
            },
            "description": "Server-Sent Events stream endpoint"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script for the collection",
          "console.log('Executing pre-request script for:', pm.info.requestName);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Test script for the collection",
          "pm.test('Status code is successful', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
          "});"
        ]
      }
    }
  ]
}
